# Slice B TEST scaffold secrets. Never commit real values, and never put a live
# key here. For local function runs:  supabase functions serve --env-file supabase/functions/.env
# For a deployed test project:       supabase secrets set --env-file supabase/functions/.env

# Turns the create/status endpoints on. Anything other than `on` answers 503.
SLICE_B_TEST_CHECKOUT=on

# Razorpay TEST keys only. The function refuses anything that is not rzp_test_.
RAZORPAY_TEST_KEY_ID=rzp_test_EXAMPLE_key_id
RAZORPAY_TEST_KEY_SECRET=EXAMPLE_key_secret

# Created in the Razorpay dashboard when the webhook endpoint is added. This is
# separate from the API key secret. Leave unset until it exists: the webhook
# answers 500 rather than accepting unverifiable events.
RAZORPAY_TEST_WEBHOOK_SECRET=EXAMPLE_webhook_secret

# Extra browser origins allowed to call the functions, comma-separated. The live
# site and localhost:3000 are always allowed.
# SLICE_B_ALLOWED_ORIGINS=https://your-test-preview.vercel.app
